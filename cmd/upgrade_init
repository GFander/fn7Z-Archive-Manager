#!/bin/bash
# 升级前准备：停止旧服务（可重复执行）
if [ -f "${TRIM_PKGVAR}/server.pid" ]; then
    pid=$(head -n 1 "${TRIM_PKGVAR}/server.pid" | tr -d '[:space:]')
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        sleep 1
    fi
    rm -f "${TRIM_PKGVAR}/server.pid" "${TRIM_APPDEST}/app.sock"
fi
exit 0

### This script is called before the user upgrades the application.

exit 0
